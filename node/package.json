{
  "name": "@walayer/sdk",
  "version": "0.1.0",
  "description": "Official Node.js and TypeScript client for the WALayer WhatsApp API. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/client.test.ts src/webhook.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "author": "Applyform LLC",
  "homepage": "https://walayer.com",
  "keywords": [
    "walayer",
    "whatsapp",
    "whatsapp-api",
    "messaging",
    "sdk",
    "webhooks"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsvint/walayer-sdks.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://walayer.com/contact"
  }
}
